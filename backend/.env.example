# Configurações de Ambiente
DEBUG=True
SECRET_KEY=sua-chave-secreta-forte-aqui-gerada-com-django
ALLOWED_HOSTS=*

# Banco de dados: 'sqlite3' para desenvolvimento local ou 'postgresql' para produção
DB_ENGINE=sqlite3

# Se DB_ENGINE=postgresql, preencha abaixo:
DB_NAME=condominio_db
DB_USER=postgres
DB_PASSWORD=suasenha
DB_HOST=localhost
DB_PORT=5432

# CORS (origens autorizadas para o frontend)
# No settings.py CORS_ALLOW_ALL_ORIGINS=True no dev, ou restrinja em produção

# E-mail (Console em dev, SMTP em produção)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CondoGestão <noreply@condogestao.com.br>
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=sua-senha-de-app

# JWT
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7
